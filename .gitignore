# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.eval-fixtures/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local review and generated presentation/document artifacts
/output/
/tmp/
/docs/thesis/defense-deck/
/docs/thesis/ppt/
/docs/thesis/figures/
/docs/thesis/*.docx
/docs/thesis/HANDOFF.md

# local assistant/editor state and build scratch space
/.claude/
/.codex_tmp/

# generated lost-property crawl reports (review decisions and published data stay tracked)
/data/lost-found-crawler/review-report.html
/data/lost-found-crawler/ai-review-report*.json
/data/lost-found-crawler/ai-review-accepts.json
/data/lost-found-crawler/verification-report.json
/data/lost-found-crawler/verification-state.json

# capacitor ios (generated by `npx cap add ios`) — copied web assets, pods, builds
/ios/App/App/public/
/ios/App/Pods/
/ios/App/output/
/ios/DerivedData/
/ios/capacitor-cordova-ios-plugins/
