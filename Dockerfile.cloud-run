FROM node:22-bookworm-slim

WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json package-lock.json ./
# pdfjs-dist loads @napi-rs/canvas in Node to provide DOMMatrix/ImageData.
# Keep optional runtime packages in the Cloud Run image; omitting them makes
# every shard fail during module initialisation before crawling begins.
RUN npm ci --include=dev

COPY scripts ./scripts
COPY lib ./lib
COPY data/lost-found-crawler ./data/lost-found-crawler
COPY public/berlin-attractions.json ./public/berlin-attractions.json
COPY public/berlin-lost-found-channels.json ./public/berlin-lost-found-channels.json

ENV NODE_ENV=production
ENTRYPOINT ["node", "--import", "tsx", "scripts/cloud-run/entrypoint.mts"]
