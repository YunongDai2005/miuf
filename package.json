{
  "name": "berlin-lost-and-found",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "shell:dev": "vite --config vite.shell.config.ts",
    "shell:build": "vite build --config vite.shell.config.ts",
    "shell:preview": "vite preview --config vite.shell.config.ts",
    "cap:sync": "npm run shell:build && cap sync ios",
    "cap:open": "cap open ios",
    "test": "npm run build && node --import tsx --test tests/rendered-html.test.mjs && npm run test:unit",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .codex_tmp",
    "typecheck": "tsc --noEmit",
    "data:lines": "node scripts/build-line-index.mjs",
    "data:venue-sources": "node --import tsx scripts/enrich-venue-sources.mts",
    "data:lost-found:inventory": "node --import tsx scripts/lost-found-crawler/cli.mts inventory",
    "data:lost-found:discover": "node --import tsx scripts/lost-found-crawler/cli.mts discover",
    "data:lost-found:scan-all": "node --import tsx scripts/lost-found-crawler/cli.mts scan-all",
    "data:lost-found:scan-report": "node --import tsx scripts/lost-found-crawler/cli.mts scan-report",
    "data:lost-found:google-discover": "node --import tsx scripts/lost-found-crawler/cli.mts google-discover",
    "data:lost-found:extract": "node --import tsx scripts/lost-found-crawler/cli.mts extract",
    "data:lost-found:merge": "node --import tsx scripts/lost-found-crawler/cli.mts merge",
    "data:lost-found:refresh": "node --import tsx scripts/lost-found-crawler/cli.mts refresh",
    "data:lost-found:review": "node --import tsx scripts/lost-found-crawler/cli.mts review",
    "data:lost-found:ai-review": "node --import tsx scripts/lost-found-crawler/cli.mts ai-review",
    "data:lost-found:review-export": "node --import tsx scripts/lost-found-crawler/cli.mts review-export",
    "data:lost-found:review-sanitize": "node --import tsx scripts/lost-found-crawler/cli.mts review-sanitize",
    "data:lost-found:quality": "node --import tsx scripts/lost-found-crawler/cli.mts quality",
    "data:lost-found:coverage": "node --import tsx scripts/lost-found-crawler/cli.mts coverage",
    "data:lost-found:browser-install": "playwright install chromium",
    "data:lost-found:verify": "node --import tsx scripts/lost-found-crawler/cli.mts verify",
    "data:lost-found:publish": "node --import tsx scripts/lost-found-crawler/cli.mts publish",
    "data:lost-found:publish-site": "node --import tsx scripts/lost-found-crawler/publish-site.mts",
    "cloud-run:build": "docker build -f Dockerfile.cloud-run -t berlin-lost-found-crawler:local .",
    "cloud-run:test": "node --import tsx --test tests/cloud-run.test.ts",
    "check:party-links": "node --import tsx scripts/check-party-links.mts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@google-cloud/storage": "^7.21.0",
    "drizzle-orm": "0.45.2",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "next": "^16.2.11",
    "playwright": "^1.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cheerio": "^1.1.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "pdfjs-dist": "5.4.624",
    "react-server-dom-webpack": "19.2.8",
    "robots-parser": "^3.0.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "undici": "^8.8.0",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.0"
  },
  "type": "module"
}
